# Copy this file to .env and fill in the keys you actually plan to use.
# Never commit .env — it's already in .gitignore.

# --- Stage 3: motion (pick one or both) ---

# Runway Dev — https://dev.runwayml.com  (Organization > API Keys)
RUNWAYML_API_SECRET=

# Kling AI — https://kling.ai/dev/api-key
KLING_API_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-5-turbo

# --- Optional: Stage 2 scene compositing on Windows/Linux, or if you'd rather
# not download the local FLUX weights on Mac. Cheapest OpenAI image model —
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Same key also powers the in-app "help me write this prompt" wizard
# (cheapest current chat model; bump to gpt-5.6-terra if outputs feel thin)
OPENAI_TEXT_MODEL=gpt-5.6-luna

# --- Licensing (RAD Media Solutions internal) ---
# Every client install: the license key RAD Media Solutions issued you.
HERO_STUDIO_LICENSE_KEY=

# RAD Media Solutions' own install ONLY. Never set this in a client's .env -
# its presence is what makes an install the admin install and unlocks the
# Admin tab. A GitHub token with `gist` scope (get one from `gh auth token`
# if you're already logged in via `gh auth login`, or create a fine-grained
# PAT with just the Gist permission at github.com/settings/tokens).
RAD_ADMIN_TOKEN=

# Raw URL of the licenses.json gist (same for every install, admin or not).
LICENSE_GIST_URL=
