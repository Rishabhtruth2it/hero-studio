# Copy this file to .env and fill in the keys you actually plan to use.
# Never commit .env — it's already in .gitignore.

# --- Stage 3: motion (pick one or both) ---

# Runway Dev — https://dev.runwayml.com  (Organization > API Keys)
RUNWAYML_API_SECRET=

# Kling AI — https://kling.ai/dev/api-key
KLING_API_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-5-turbo

# --- Optional: Stage 2 fallback / higher-fidelity compositing via API instead of local FLUX ---
GEMINI_API_KEY=
